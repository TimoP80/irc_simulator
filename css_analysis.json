  "src/index.css": [
    {
      "selector": "@tailwind base;\r\n@tailwind components;\r\n@tailwind utilities;\r\n\r\n\r\n@layer base",
      "properties": {
        "@apply": "html, body {\r\n    bg-irc-bg text-irc-text font-mono;\r\n    overflow-x: hidden;\r\n  }\r\n  \r\n  #root {\r\n    @apply h-screen w-screen;\r\n  }"
      }
    },
    {
      "selector": "@layer components",
      "properties": {
        "@apply": ".irc-channel {\r\n    bg-gray-800 border border-gray-700 rounded-lg p-4 mb-2;\r\n  }\r\n  \r\n  .irc-channel-header {\r\n    @apply flex items-center justify-between p-3 border-b border-gray-700 bg-gray-900;\r\n  }\r\n  \r\n  .irc-channel-title {\r\n    @apply text-lg font-semibold text-white truncate;\r\n  }\r\n  \r\n  .irc-channel-status {\r\n    @apply flex items-center gap-2 text-xs text-gray-400;\r\n  }\r\n  \r\n  .irc-status-dot {\r\n    @apply w-1.5 h-1.5 bg-green-500 rounded-full;\r\n  }\r\n  \r\n  \r\n  .irc-message {\r\n    @apply p-2 border-b border-gray-700 last:border-b-0;\r\n  }\r\n  \r\n  .irc-message-header {\r\n    @apply flex items-center gap-2 mb-1;\r\n  }\r\n  \r\n  .irc-message-nick {\r\n    @apply font-semibold text-blue-400;\r\n  }\r\n  \r\n  .irc-message-time {\r\n    @apply text-xs text-gray-500;\r\n  }\r\n  \r\n  .irc-message-content {\r\n    @apply text-gray-200 break-words;\r\n  }\r\n  \r\n  \r\n  .irc-input {\r\n    @apply w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500;\r\n  }\r\n  \r\n  .irc-input:focus {\r\n    @apply ring-1 ring-blue-500;\r\n  }\r\n  \r\n  \r\n  .irc-button {\r\n    @apply bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded transition-colors duration-200;\r\n  }\r\n  \r\n  .irc-button-secondary {\r\n    @apply bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded transition-colors duration-200;\r\n  }\r\n  \r\n  .irc-button-danger {\r\n    @apply bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded transition-colors duration-200;\r\n  }\r\n  \r\n  \r\n  .irc-modal {\r\n    @apply fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50;\r\n  }\r\n  \r\n  .irc-modal-content {\r\n    @apply bg-gray-800 border border-gray-700 rounded-lg p-6 max-w-md w-full mx-4;\r\n  }\r\n  \r\n  .irc-modal-header {\r\n    @apply flex items-center justify-between mb-4;\r\n  }\r\n  \r\n  .irc-modal-title {\r\n    @apply text-xl font-semibold text-white;\r\n  }\r\n  \r\n  .irc-modal-close {\r\n    @apply text-gray-400 hover:text-white transition-colors;\r\n  }\r\n  \r\n  \r\n  .irc-form-group {\r\n    @apply mb-4;\r\n  }\r\n  \r\n  .irc-form-label {\r\n    @apply block text-sm font-medium text-gray-300 mb-2;\r\n  }\r\n  \r\n  .irc-form-input {\r\n    @apply w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500;\r\n  }\r\n  \r\n  .irc-form-select {\r\n    @apply w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white focus:outline-none focus:border-blue-500;\r\n  }\r\n  \r\n  .irc-form-textarea {\r\n    @apply w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 resize-none;\r\n  }\r\n  \r\n  \r\n  .irc-list {\r\n    @apply bg-gray-800 border border-gray-700 rounded-lg overflow-hidden;\r\n  }\r\n  \r\n  .irc-list-item {\r\n    @apply p-3 border-b border-gray-700 last:border-b-0 hover:bg-gray-700 transition-colors;\r\n  }\r\n  \r\n  .irc-list-item:last-child {\r\n    @apply border-b-0;\r\n  }\r\n  \r\n  \r\n  .irc-nav {\r\n    @apply bg-gray-900 border-b border-gray-700 p-4;\r\n  }\r\n  \r\n  .irc-nav-item {\r\n    @apply text-gray-300 hover:text-white transition-colors px-3 py-2 rounded;\r\n  }\r\n  \r\n  .irc-nav-item.active {\r\n    @apply bg-gray-700 text-white;\r\n  }\r\n  \r\n  \r\n  .irc-status-online {\r\n    @apply text-green-400;\r\n  }\r\n  \r\n  .irc-status-away {\r\n    @apply text-yellow-400;\r\n  }\r\n  \r\n  .irc-status-busy {\r\n    @apply text-red-400;\r\n  }\r\n  \r\n  .irc-status-offline {\r\n    @apply text-gray-400;\r\n  }\r\n  \r\n  \r\n  .irc-scrollbar {\r\n    scrollbar-width: thin;\r\n    scrollbar-color: #4b5563 #1f2937;\r\n  }\r\n  \r\n  .irc-scrollbar::-webkit-scrollbar {\r\n    width: 6px;\r\n  }\r\n  \r\n  .irc-scrollbar::-webkit-scrollbar-track {\r\n    background: #1f2937;\r\n  }\r\n  \r\n  .irc-scrollbar::-webkit-scrollbar-thumb {\r\n    background: #4b5563;\r\n    border-radius: 3px;\r\n  }\r\n  \r\n  .irc-scrollbar::-webkit-scrollbar-thumb:hover {\r\n    background: #6b7280;\r\n  }"
      }
