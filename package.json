{
  "name": "station-v-executable",
  "private": true,
  "version": "1.21.0",
  "type": "module",
  "description": "Station V - Virtual IRC Simulator - Desktop Executable - A cross-platform desktop application for simulating IRC chat environments with AI-powered virtual users",
  "author": "Station V Development Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimoP80/station_v_executable.git"
  },
  "homepage": "https://github.com/TimoP80/station_v_executable#readme",
  "bugs": {
    "url": "https://github.com/TimoP80/station_v_executable/issues"
  },
  "keywords": [
    "irc",
    "simulator",
    "ai",
    "chat",
    "desktop",
    "electron",
    "virtual-users",
    "gemini-ai"
  ],
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm:server\" \"vite\"",
    "server": "cross-env PORT=8081 node server/station-v-server.mjs",
    "predev": "npm run build:server",
    "test-api-key": "node scripts/test-api-key.js",	
    "dev": "concurrently --kill-others-on-fail \"npm:server\" \"vite\"",
    "dev:electron": "wait-on http://localhost:3000 && cross-env ELECTRON_RUN_AS_NODE=0 npx electron .",
    "build:server": "npx tsc --project tsconfig.server.json",
    "build": "npm run clean && tsc --project tsconfig.electron.json && node -e \"const fs = require('fs'); if (!fs.existsSync('dist-electron')) { fs.mkdirSync('dist-electron'); } fs.writeFileSync('dist-electron/package.json', JSON.stringify({ type: 'commonjs' }))\" && node scripts/generate-hash.js && cross-env ELECTRON=true vite build && npm run copy:config",
    "package": "npm run build && node scripts/build-electron.js",
    "package:win": "npm run build && node scripts/build-windows-dist.js",
    "clean": "rimraf dist dist-electron release",
    "copy:config": "node -e \"const fs=require('fs');const path=require('path');try{fs.copyFileSync('default-config.json','dist/default-config.json');console.log('✅ Copied default-config.json');}catch(e){console.log('⚠️ Config copy skipped:',e.message);}\"",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:wrapper": "node scripts/test-wrapper.js",
    "build:wrapper": "node scripts/build-test-wrapper.js",
    "dev:full": "start cmd /c dev-full.bat",
    "dev:full:ps1": "powershell -ExecutionPolicy Bypass -File dev-full.ps1"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "express": "^4.19.2",
    "openai": "^4.52.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^22.18.12",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.2.4",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.18",
    "terser": "^5.44.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "wait-on": "^8.0.5"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "com.stationv.ircsimulator",
    "productName": "Station V - Virtual IRC Simulator",
    "asar": true,
    "asarUnpack": [
      "node_modules/electron/dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "server/**/*",
      "electron-starter.cjs",
      "node_modules/**/*",
      "!node_modules/electron/dist/**/*"
    ],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/icudtl.dat",
        "to": "icudtl.dat"
      },
      {
        "from": "node_modules/electron/dist/chrome_100_percent.pak",
        "to": "chrome_100_percent.pak"
      },
      {
        "from": "node_modules/electron/dist/chrome_200_percent.pak",
        "to": "chrome_200_percent.pak"
      },
      {
        "from": "node_modules/electron/dist/resources.pak",
        "to": "resources.pak"
      },
      {
        "from": "node_modules/electron/dist/snapshot_blob.bin",
        "to": "snapshot_blob.bin"
      }
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "favicon.ico",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.ico",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico"
    },
    "dmg": {
      "title": "Station V - Virtual IRC Simulator",
      "icon": "favicon.ico"
    },
    "publish": null
  }
}
